include "/home/sorutrt/dotfiles/niri/config.kdl"

binds {
    XF86Launch7 hotkey-overlay-title="Take a Screenshot" { screenshot; }
    Mod+V repeat=false hotkey-overlay-title="Toggle Voice Input" { spawn "voxtype" "record" "toggle"; }
}

input {
    keyboard {
        xkb {
            layout "us"
            options "caps:ctrl_modifier"
        }
    }
}
